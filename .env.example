# Payegis Studio v3.1 — Environment Configuration (.env.example)
# Copy to .env (`cp .env.example .env`). `server.mjs` automatically loads `.env` at startup.

PORT=8787
NODE_ENV=development
PAYPAL_ENV=sandbox
ALLOW_LIVE_PRODUCTION=false

# PayPal Developer Sandbox Credentials (https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Operator Authentication & Exact Allowed CORS Origins (Mandatory when NODE_ENV=production)
PAYEGIS_OPERATOR_TOKEN=
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,https://mahinm229.github.io
TRUST_PROXY=false

# Channel3 Product & Merchant Intelligence API (https://trychannel3.com)
CHANNEL3_API_KEY=your_channel3_api_key_here
CHANNEL3_BASE_URL=https://api.trychannel3.com/v0

# Optional Live LLM Provider (OpenAI / Gemini / NVIDIA Nemotron compatible)
AI_API_KEY=
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# PostgreSQL Connection String for Durable Checkpoints & Operation Journal on Render
DATABASE_URL=postgresql://payegis_user:password@localhost:5432/payegis_hitl_state

# Configurable Policy & Authorization Thresholds (Enforced by fsm-and-policy.mjs)
MAX_SINGLE_ORDER_USD=1500.00
HUMAN_GATE_THRESHOLD_USD=250.00
HONOR_PERIOD_HOURS=72
MAX_VALIDITY_DAYS=29
